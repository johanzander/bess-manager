{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "enableWeakerNetworkIsolation": true,
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.SecurityServer",
        "com.apple.securityd",
        "com.apple.trustd",
        "com.apple.trustd.agent"
      ]
    },
    "filesystem": {
      "allowWrite": [
        ".",
        "~/GitHub/bess-manager"
      ]
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Skill",
      "Glob",
      "Grep",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/pytest)",
      "Bash(.venv/bin/black *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(.venv/bin/mypy *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/pip show *)",
      "Bash(.venv/bin/pip list)",
      "Bash(podman machine start *)",
      "Bash(podman machine start)",
      "Bash(podman machine stop *)",
      "Bash(podman machine stop)",
      "Bash(podman-compose *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge --ff-only *)",
      "Bash(gh issue view *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr review *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(podman machine rm *)",
      "Bash(podman machine rm)",
      "Bash(podman system reset *)",
      "Bash(podman system reset)",
      "Bash(git stash)",
      "Bash(git stash push)",
      "Bash(git stash push *)",
      "Bash(git stash save)",
      "Bash(git stash save *)",
      "Bash(git stash pop)",
      "Bash(git stash pop *)",
      "Bash(git stash apply)",
      "Bash(git stash apply *)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git stash branch *)",
      "Bash(git stash create)",
      "Bash(git stash store *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(sudo *)"
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.claude/hooks/pretest-on-commit.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.claude/hooks/check-worktree-path.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.claude/hooks/optimizer_core_principles.py\"",
            "statusMessage": "Checking optimizer-core principles"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}/.claude/hooks/lint-edited-python.sh\""
          }
        ]
      }
    ]
  }
}
