FROM python:3.13-slim

# Set work directory
WORKDIR /app

# Install OS-level dependencies (libfaketime enables wall-clock override in mock mode)
# The .so lives under a multiarch-specific path (e.g. x86_64-linux-gnu on CI
# runners, aarch64-linux-gnu on Apple Silicon dev machines) -- symlink it to a
# fixed path so LD_PRELOAD works the same way regardless of build platform.
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libfaketime \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(find /usr/lib -name libfaketime.so.1 | head -1)" /usr/local/lib/libfaketime.so.1

# Copy requirements and install them (as root)
# --root-user-action=ignore: pip's root warning is aimed at people installing
# into a host OS; this is a throwaway dev container with nothing to conflict
# with, so a venv would buy nothing. --disable-pip-version-check drops the
# "a new release of pip is available" notice, which is never actionable here.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --root-user-action=ignore --disable-pip-version-check \
    -r requirements.txt

# Copy rest of the code
COPY backend/ /app/
COPY core/bess /app/core/bess

# Expose port
EXPOSE 8080

# Run with uvicorn
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
